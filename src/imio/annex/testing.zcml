<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    i18n_domain="imio.annex">

  <!-- The export PDF and Zip forms are registered by the applications on their own
       containers, register them on everything for the tests. -->
  <browser:page
      for="*"
      layer="imio.annex.interfaces.IImioAnnexLayer"
      name="export-pdf-form"
      class="imio.annex.browser.views.ExportPDFForm"
      permission="zope2.View" />

  <browser:page
      for="*"
      layer="imio.annex.interfaces.IImioAnnexLayer"
      name="export-zip-form"
      class="imio.annex.browser.views.ExportZipForm"
      permission="zope2.View" />

</configure>
